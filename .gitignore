# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物 ----------
# 安装包与解包目录体积很大（数百 MB），绝不入库；由 CI 或本地 npm run dist:win 产出
dist/
dist-new/
release/
*.exe
*.dmg
*.blockmap

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.tmp
*.bak
*.bak-*
.tmp-*

# ---------- 编辑器 ----------
.vscode/
.idea/

# 注意：build/ 要入库 —— 它是 electron-builder 的 buildResources（图标在这里），
# 且 package.json 的 extraResources 会引用它。虽然 make-icon.mjs 能重新生成，
# 但入库后 `pack` 等命令不依赖先跑图标脚本，CI 也更稳。

# 国际化提取脚本产生的中间文件
scripts/.strings*.json
scripts/.ui-strings.json
scripts/.harvested.json
scripts/.to-translate.json

# ---------- 本地运行数据（含明文 API Key，绝不入仓）----------
# 桌面版把数据写到用户目录（%APPDATA%\Cline Pass Switcher\ 等），本来就不在仓库里；
# 但直接跑 `npm run engine` 时 DATA_DIR 默认是 src/main/engine/，会在仓库内生成这些文件。
/config.json
/metadata.json
/app-settings.json
/usage/
/src/main/engine/config.json
/src/main/engine/metadata.json
/src/main/engine/app-settings.json
/src/main/engine/usage/

# 注意：resources/seed/metadata.json 是随程序分发的演示数据，必须入库，不要用全局
# `metadata.json` 规则把它一起忽略了。

# ---------- 环境变量与证书 ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
