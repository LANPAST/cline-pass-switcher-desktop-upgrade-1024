{
  "name": "cline-pass-switcher-desktop-upgrade-1024",
  "productName": "cline-pass-switcher-desktop-upgrade-1024",
  "version": "2.4.0",
  "description": "Cline Pass 上游控制台桌面版：枚举/校验/钉住订阅模型背后的上游渠道，账号池轮询，OpenAI 兼容代理",
  "author": {
    "name": "cline-pass-switcher-desktop-upgrade-1024",
    "email": "noreply@example.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "electron .",
    "engine": "node src/main/engine/engine.js",
    "dist:win": "node scripts/make-icon.mjs && electron-builder --win --x64",
    "dist:mac": "node scripts/make-icon.mjs && electron-builder --mac",
    "dist:all": "electron-builder --win --mac --x64 --arm64",
    "pack": "electron-builder --dir",
    "icon": "node scripts/make-icon.mjs",
    "test:unit": "node scripts/test-anthropic.mjs",
    "test:has": "node scripts/test-gateway-has.mjs",
    "test:live": "node scripts/test-messages-live.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:e2e": "bash scripts/test-claude-code-e2e.sh",
    "probe": "node scripts/probe-upstream.mjs",
    "test:claudecfg": "node scripts/test-claude-config.mjs",
    "test:context": "node scripts/test-context-e2e.mjs",
    "test:cny": "node scripts/test-pricing-cny.mjs",
    "test:usage": "node scripts/test-usage.mjs",
    "test:usage-offline": "node scripts/test-usage-e2e2.mjs",
    "test:usage-e2e": "bash scripts/test-usage-e2e.sh",
    "test:usage-sink": "node scripts/test-usage-sink.mjs",
    "test:i18n": "node scripts/check-i18n-usage.mjs",
    "test:delegate": "node scripts/test-delegate.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:usage-live": "node scripts/test-usage-live.mjs",
    "build:win": "scripts\\build-win.bat",
    "build:mac": "bash scripts/build-mac.sh"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "dependencies": {},
  "build": {
    "appId": "com.clinepass.switcher",
    "productName": "cline-pass-switcher-desktop-upgrade-1024",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/seed",
        "to": "seed"
      },
      {
        "from": "build",
        "to": "build"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "cline-pass-switcher-desktop-upgrade-1024",
      "artifactName": "cline-pass-switcher-desktop-upgrade-1024-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "cline-pass-switcher-desktop-upgrade-1024-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "cline-pass-switcher-desktop-upgrade-1024-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "cline-pass-switcher-desktop-upgrade-1024"
    }
  }
}
